# --- Local agent-network scaffolding (never publish) ---
.anet/
.mcp.json

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Kernel payload ---
# Installed by `npm run kernel:install` from the version pinned in upstream.lock.json,
# which is the thing under version control. The tree itself is a build artefact.
resources/kernel/

# --- Default-profile payload ---
# The manifest (`package.json`) is checked in so the build pipeline knows which
# bundles ship; the `node_modules/` tree under it is a build artefact that
# `npm run kernel:install` rebuilds from the locked kernel + shipped plugins.
resources/default-profile/node_modules/

# --- Build output ---
out/
dist/
build/
release/
*.tsbuildinfo

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Test & coverage ---
coverage/
.vitest/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
logs/
*.log
npm-debug.log*
